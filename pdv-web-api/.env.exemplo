# Copie para .env e preencha — ou gere tudo automaticamente com:  bash scripts/criar-env.sh
# O arquivo .env NÃO deve ser versionado.

# Superusuário do PostgreSQL: só administração e backup (a API não usa)
DB_ADMIN_USER=pdv_admin
DB_ADMIN_PASSWORD=
# Dono do esquema, usado só pelas migrações Flyway
DB_MIGRACAO_PASSWORD=
# Usuário da API: lê e grava dados, não altera a estrutura
DB_APP_PASSWORD=

# No mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
PDV_JWT_SEGREDO=
# Gerente inicial, criado na primeira subida se ainda não existir nenhum gerente
PDV_ADMIN_CPF=
PDV_ADMIN_SENHA=

# Base da comissão: LIQUIDO (padrão — total após descontos, como no exemplo da API v2.3) ou BRUTO (subtotal)
PDV_COMISSAO_BASE=LIQUIDO
# true em produção atrás de um proxy/balanceador com TLS: HTTP vira redirecionamento para HTTPS e HSTS é enviado
PDV_EXIGIR_HTTPS=false
# Proxy TLS (serviço "proxy"): descomente COMPOSE_PROFILES=tls para subir o Caddy nas portas 80/443.
# PDV_DOMINIO=localhost usa certificado da CA interna do Caddy; um domínio real recebe certificado Let's Encrypt.
# Em produção use também PDV_EXIGIR_HTTPS=true.
#COMPOSE_PROFILES=tls
PDV_DOMINIO=localhost
# true publica /swagger-ui.html e /v3/api-docs (recomendado só em homologação)
PDV_DOCUMENTACAO_API=false

# Backup automático (serviço "backup"): intervalo e quantos dias manter as cópias em ./backups
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCAO_DIAS=7
